# Frontend configuration
VITE_AI_CHAT_ENDPOINT=/.netlify/functions/groq-chat
VITE_GROQ_MODEL=llama-3.3-70b-versatile

# Optional future API endpoints
VITE_EVENTS_API_URL=
VITE_SCHEDULING_API_URL=
VITE_INSIGHTS_API_URL=

# Netlify function secrets — set these in Netlify Dashboard > Site > Environment Variables
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouteService API key — get a free key at https://openrouteservice.org/dev/#/signup
# Required for travel-time-aware reminders (falls back to distance estimate if missing)
VITE_ORS_API_KEY=your-openrouteservice-api-key-here
